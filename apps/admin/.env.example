# The API gateway — the admin console reaches ProviderRegistry through it (one origin,
# ops-key gated). Catalog / orchestrator / consumers are still called directly for now.
VITE_API_URL=http://localhost:5070

# Shared ops key the gateway checks on provider routes. Placeholder for v1 (matches the
# gateway's Gateway:OpsKey default), same trust model as the placeholder ops/mtaapal-admin login.
VITE_OPS_KEY=dev-ops-key

# Direct base URLs for the services the gateway doesn't front yet, straight from the browser.
VITE_SERVICE_CATALOG_URL=http://localhost:5062
VITE_SERVICE_REQUEST_ORCHESTRATOR_URL=http://localhost:5063
VITE_CONSUMERS_URL=http://localhost:5065
