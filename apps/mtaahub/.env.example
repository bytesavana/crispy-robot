# MtaaHub talks to three effective-happiness services directly. Simulator/emulator defaults work
# as-is. On a physical device, "localhost" resolves to the phone itself, not your dev machine —
# use your machine's LAN IP instead, e.g.:
#   EXPO_PUBLIC_ORCHESTRATOR_URL=http://192.168.1.23:5063
# Find it on macOS with: ipconfig getifaddr en0
#
# Note that ServiceRequestOrchestrator and ProviderRegistry bind to localhost in their
# launchSettings.json (unlike IdentityServer, which already binds 0.0.0.0), so a phone on the LAN
# can't reach them until those are changed too. See the MtaaHub section of the repo README.

# ServiceRequestOrchestrator — runs, stops, task offers, line reporting.
EXPO_PUBLIC_ORCHESTRATOR_URL=http://localhost:5063

# ProviderRegistry — resolves the signed-in phone number to a Provider.
EXPO_PUBLIC_PROVIDER_REGISTRY_URL=http://localhost:5064

# IdentityServer — OTP sign-in.
EXPO_PUBLIC_IDENTITY_SERVER_URL=http://localhost:5066

# Run as a fixed provider, skipping OTP sign-in and the ProviderRegistry lookup — for local dev
# against the orchestrator's seeded fixtures (effective-happiness DevDataSeeder stamps its jobs with
# this id). Leave unset for real work.
# EXPO_PUBLIC_PROVIDER_ID=d0000000-0000-4000-8000-00000000f001

# Demo data. Set to 1 to serve the ProviderRegistry/catalog reads (categories, coverage) from
# in-memory fixtures — those have no local backend yet. Jobs, offers and tasks always come from the
# orchestrator now. Every screen shows a "Demo data" banner while this is on. Leave unset for real work.
# EXPO_PUBLIC_DEMO_DATA=1
