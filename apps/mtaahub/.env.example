# MtaaHub talks to two backend origins:
#   - EXPO_PUBLIC_API_URL: the API gateway, which fronts ServiceCatalog, ProviderRegistry and
#     ServiceRequestOrchestrator behind one origin and validates the sign-in token.
#   - EXPO_PUBLIC_IDENTITY_SERVER_URL: IdentityServer, called directly for OTP sign-in.
#
# Simulator/emulator defaults work as-is. On a physical device, "localhost" resolves to the phone
# itself, not your dev machine — use your machine's LAN IP instead, e.g.:
#   EXPO_PUBLIC_API_URL=http://192.168.1.23:5070
# Find it on macOS with: ipconfig getifaddr en0
#
# The gateway binds 0.0.0.0, so a phone on the LAN can reach it (and the resource services behind
# it) without changing each service's launchSettings.json. IdentityServer also already binds
# 0.0.0.0. Tokens are minted with a fixed issuer (IdentityServer:IssuerUri), so LAN clients still
# validate at the gateway.

# API gateway — fulfillment, provider registry and catalog, behind one origin.
EXPO_PUBLIC_API_URL=http://localhost:5070

# IdentityServer — OTP sign-in and token issuance (not behind the gateway).
EXPO_PUBLIC_IDENTITY_SERVER_URL=http://localhost:5066

# To run against a seeded dev provider, sign in as +254700000003 — the OTP is printed in the
# IdentityServer log (overmind connect identityserver). No env shortcut for this anymore.

# Demo data. Set to 1 to serve the ProviderRegistry/catalog reads (categories, coverage) from
# in-memory fixtures — those have no local backend yet. Jobs, offers and tasks always come from the
# orchestrator now. Every screen shows a "Demo data" banner while this is on. Leave unset for real work.
# EXPO_PUBLIC_DEMO_DATA=1
